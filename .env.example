# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Stage 1 (acquisition) needs NO keys. These are for the stubbed downstream stages.

# --- Crawl identity: goes in the User-Agent so Seeley can contact us. ---
SEELEY_CRAWLER_CONTACT=

# --- Model providers (Stage 2b vision, Stage 4 embeddings, Stage 6 generation) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# --- Freshdesk API: currently unobtainable (/api/v2/* returns 401). ---
# Populate only if a key is ever granted; see _context/02-decisions/0002-crawl-instead-of-api.md
FRESHDESK_API_KEY=

# --- Overrides for config/config.yaml (optional; blank = use the YAML value) ---
SEELEY_DATA_ROOT=
SEELEY_LOG_LEVEL=
SEELEY_CRAWL_RPS=

# --- Hosted page images (optional) ---
# Public prefix containing {doc_id}/{0000.png}. Leave blank for local /pages URLs.
PAGE_IMAGE_BASE_URL=
